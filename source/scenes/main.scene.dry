title: Next month
is-hand: true
on-arrival: {!
# Pinned-card description bookkeeping - tells the player when their next
# advisor action and leadership reshuffle become available. Mirrors the
# base game's advisor_action_timer/shuffle_leadership_timer pattern exactly;
# no Russia-specific changes needed here, since this is pure UI plumbing.
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Advisors - an action is available';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = 'Advisors - next action available in 1 month';
} else {
    Q.pinnedCardsDescription = 'Advisors - next action available in ' + Q.advisor_action_timer + ' months';
}

if (Q.shuffle_leadership_timer <= 0) {
    Q.pinnedCardsDescription += '\n- a reshuffle is available.';
} else if (Q.shuffle_leadership_timer == 1) {
    Q.pinnedCardsDescription += '\n- next reshuffle in 1 month';
} else {
    Q.pinnedCardsDescription += '\n- next reshuffle in ' + Q.shuffle_leadership_timer + ' months.';
}

# ===== ELECTION-CYCLE PACING HOOK (DESIGN_DOC §6) =====
# Q.election_proximity is maintained in set_next_election_time.scene.dry.
# This block sets Q.pinnedCardsDescription context for the campaign window and
# is the natural home for any future month_actions-per-week throttling during
# the 3-month pre-election window - not yet implemented in this skeleton pass,
# since we're standing up the mechanical structure before layering pacing logic
# and flavor text on top of it.
if (Q.election_proximity <= 3 && Q.election_proximity >= 1 && !Q.election_called) {
    Q.election_called = 1;
}
if (Q.election_proximity < 1) {
    Q.campaign_locked = 1;
} else {
    Q.campaign_locked = 0;
}

# ===== FLAVOR TRIGGER BOOKKEEPING (placeholder structure, no content yet) =====
# The base game tracks ~60+ dated flavour_N_trigger flags here, each firing a
# one-shot narrative paragraph later in this file's card body. We are
# deliberately deferring flavor-paragraph content to a later pass (per project
# decision) but keeping the same trigger/shown/time bookkeeping pattern ready
# to receive it, so flavor text can be added without restructuring this file.
# Example shape (commented out until real Act I flavor content is written):
#
# if (Q.year == 1998 && Q.month == 8 && Q.time !== Q.last_time_updated) {
#     Q.flavour_0_trigger += 1;
#     if (Q.flavour_0_trigger && !Q.flavour_0_trigger_shown) {
#         Q.flavour_0_trigger_time = Q.time;
#         Q.flavour_0_trigger_shown = 1;
#     }
# }

Q.last_time_updated = Q.time;
if (Q.week) Q.last_week_updated = Q.week; 
!}

max-cards: 3

#Here, the main deck will be displayed. Clicking on the deck draws a card into your hand. Clicking on a card activates that card.

{!<div class="scrollable-box">!}

// Flavor paragraphs (per-month narrative text, [? if year = X and month = Y: ... ?]
// style, matching the base game's pattern) are intentionally not yet written here.
// See DESIGN_DOC and the flavour-trigger placeholder above for the intended
// structure once that content pass begins.

{!</div>!}

- @party
- @govt
- @eco
- @time
- #advisor
- @shuffle_leadership_pinned


@party
title: Party Affairs
card-image:
is-deck: true

- #party_affairs

@govt
title: Government Affairs
view-if: time >= 6
card-image:
is-deck: true

- #govt_affairs

@eco
title: Economic Policy
view-if: yabloko_in_government = 1 and (economy_minister_party = "Yabloko" or finance_minister_party = "Yabloko") and economic_policy_timer <= 0
card-image:
is-deck: true

- @economic_policy


@economic_policy
title: Economic Policy
on-arrival: economic_policy_timer += 6; month_actions += 1;

# Placeholder economic-policy card: fires only once Zadornov (or a future
# Yabloko-affiliated economy/finance minister) is actually in post, per
# root.scene.dry's zadornov_recruited_back mechanic. Full content (real
# 1998-era policy choices - tax reform, IMF negotiations, budget priorities)
# is deferred to a later content pass; this stub exists so @eco's option
# resolves to a real, titled scene rather than an empty/missing reference.

With a Yabloko-affiliated minister at the Finance Ministry, the party has a real say in economic policy.

- @continue_eco: Continue.

@continue_eco

@time
title: Bide our Time
view-if: state_pressure >= 50 and executive_relation <= 10
card-image:
is-deck: true

- @wait_filler


@wait_filler
title: There is little to be done for now.

There is little to be done for now. The party continues its ordinary work.

- @continue: Continue.

@continue

@main_easy
# Difficulty tiers below normal (Q.difficulty < 0) are not yet implemented
# for this mod - aliased directly to the normal hand so post_event.scene.dry's
# existing main.main_easy branch (for difficulty < 0) still resolves to a real
# scene rather than erroring, until a real easy-mode variant is built.
go-to: main
