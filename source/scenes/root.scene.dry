@act1_confirm
on-arrival: {!
Q.started = 1;

// ===== TIME =====
// time elapsed (in months)
Q.time = 1;
Q.year = 1998;
Q.month = 1;
Q.week = 0;
Q.week_checked = 0;
// how many actions have been taken this month?
Q.month_actions = 0;
Q.month_actions_checked = 0;

// which act did the player start in? used to gate recap cards per DESIGN_DOC §5.
Q.start_act = 1;
Q.is_skip_start = 0;

// 0 = normal difficulty, 1 = hard mode, 2 = hard mode no saves
Q.difficulty = 0;

// ===== PARTY RESOURCES =====
Q.resources = 3;
Q.dues = 4;
Q.base_dues = 4;
Q.budget = 3;

// overall dissent - reduces every increase in party support.
Q.dissent = 0.05;
Q.dissent_percent = 5;

// ===== FACTIONS =====
// ideological currents only, per DESIGN_DOC §2.
// Human Rights, Women's/Gender, Youth, and Entrepreneurs' wings are modeled as
// non-factional advisors instead, since they're constituency wings, not ideologies.
Q.factions = ['yavlinsky_wing', 'social_democrat_wing', 'liberal_conservative_fringe', 'green_russia', 'shlosberg_wing', 'shtefanov_fringe'];

Q.yavlinsky_wing_strength = 60;
Q.yavlinsky_wing_dissent = 0;
Q.social_democrat_wing_strength = 30;
Q.social_democrat_wing_dissent = 5;
Q.liberal_conservative_fringe_strength = 10;
Q.liberal_conservative_fringe_dissent = 10;

// dormant factions - exist as variables from turn one (per the base game's
// social_patriot precedent) but hidden/unselectable in the UI via view-if
// gating on their _unlocked flag until their real-world unlock date.
Q.green_russia_strength = 0;
Q.green_russia_dissent = 0;
Q.green_russia_unlocked = 0;

Q.shlosberg_wing_strength = 0;
Q.shlosberg_wing_dissent = 0;
Q.shlosberg_wing_unlocked = 0;

Q.shtefanov_fringe_strength = 0;
Q.shtefanov_fringe_dissent = 0;
Q.shtefanov_fringe_unlocked = 0;

// Katz wing is external pressure, not a strength/dissent faction - see DESIGN_DOC §2.
Q.katz_pressure = 0;
Q.katz_wing_unlocked = 0;
Q.katz_exited = 0;

// ===== STATE PRESSURE AND OLIGARCH RELATION =====
// state pressure - cumulative administrative harassment. See DESIGN_DOC §7.
// Low but nonzero even in 1998 - Yabloko already faced friction as an
// opposition-leaning party under Yeltsin, well before the Putin-era escalation.
Q.state_pressure = 2;

// oligarch relation - see DESIGN_DOC §7. Yavlinsky's real public position was
// sharply critical of loans-for-shares privatization, so this starts low-moderate
// rather than high; it is a genuine trade-off lever, not a free resource.
Q.oligarch_relation = 20;

// ===== ELECTION TIMING =====
Q.next_election_time = 24;
Q.next_election_month = 12;
Q.next_election_year = 1999;
Q.time_to_election = 24;
Q.election_called = 0;
Q.election_proximity = 24;

// PR seat threshold (%) for Duma list seats - 5% pre-2007, 7% 2007-2011, back
// to 5% from 2016 (DESIGN_DOC §7, mechanic 3). election_algorithm.scene.dry
// falls back to 5 if unset, but declared explicitly here for visibility.
Q.pr_threshold = 5;
// separate, much higher PR threshold (20%) specifically for the 'other'
// bucket - see election_algorithm.scene.dry Stage 2a. Since we don't model
// every mid-sized party individually (no Fatherland-All Russia-equivalent
// entry, for instance), a large 'other' share at this scale is standing in
// for a real party that would plausibly clear the ordinary threshold on its
// own, so it becomes PR-eligible above this higher bar rather than being
// permanently locked out of list seats regardless of size.
Q.pr_other_threshold = 20;

// ===== ECONOMY =====
// sourced: IMF "Russia Rebounds" key monetary indicators table.
// GDP growth 1997 = 1.4%; year-end inflation 1997 = 11.0%. The 1998 August
// crisis (GDP -5.3%, inflation 84.5% by year end) is modeled as a dated event
// later in the year, not baked into the January starting values.
Q.economic_growth = 1.4;
Q.inflation = 11.0;
Q.economic_expansion = 0;
Q.unemployment = 11.2;
Q.gdp_index = 100;
Q.ruble_exchange_rate = 6.1;
Q.ruble_crisis_occurred = 0;
Q.budget_deficit_gdp = 5.9;

// quality of life (as % of Jan 1998 baseline, currently unused - should be welfare-adjusted)
Q.urban_professional_qol = 100;
Q.intelligentsia_pensioners_qol = 100;
Q.working_class_qol = 100;
Q.rural_qol = 100;
Q.business_entrepreneurial_qol = 100;
Q.youth_diaspora_qol = 100;

// Proportion of different social groups (% of population, distinct from vote share)
// broad approximation for late-1990s Russia; refine with sourced figures later.
Q.urban_professional = 22;
Q.intelligentsia_pensioners = 20;
Q.working_class = 28;
Q.rural = 18;
Q.business_entrepreneurial = 5;
Q.youth_diaspora = 7;

// policy tracks (relative to Jan 1998 baseline, can go negative)
Q.welfare = 0;
Q.privatization_progress = 0;
Q.market_reform = 0;
Q.rule_of_law = 0;
Q.press_freedom = 0;
Q.decentralization = 0;
Q.tax_reform = 0;
Q.pension_reform = 0;

// foreign relations (relative to baseline)
Q.west_relation = 30;
Q.eu_relation = 20;
Q.nato_relation = 10;
Q.cis_relation = 40;
Q.chechnya_conflict = 1;
Q.chechnya_war_support = -10;

// ===== DEMOGRAPHIC CLASSES =====
Q.classes = ['urban_professional', 'intelligentsia_pensioners', 'working_class', 'rural', 'business_entrepreneurial', 'youth_diaspora'];

// ===== PARTIES =====
// SR and Unity/UR do not exist yet in 1998; their _formed flags gate their
// appearance in event/advisor content, while their Q.parties array membership
// is added at the point they're founded. RPR has existed continuously since
// 1990 (predecessor to RPR-PARNAS, which does not form until 2012) and is
// active but minor in 1998 - included in the array from the start rather than
// as a dormant flag, since it is genuinely present, not merely founded later.
Q.parties = ['yabloko', 'kprf', 'ldpr', 'ndr', 'rpr', 'other'];
Q.parties_graph = ['yabloko', 'kprf', 'ldpr', 'ndr', 'rpr', 'other'];

Q.unity_formed = 0;
Q.ur_formed = 0;
Q.sps_formed = 0;
Q.sr_formed = 0;
Q.rpr_dissolved = 0;
Q.rpr_parnas_formed = 0;
Q.kedr_formed = 1;
Q.kedr_transformed_greens = 0;

// Support for party by demographic class (1998 baseline).
// Seeded from the real 1995 Duma election (Yabloko 6.89% PR / 45 total seats;
// KPRF 22.30%; LDPR 11.18%; NDR/Our Home is Russia 10.13% as the pro-government
// bloc predating Unity). RPR held negligible vote share in the 1995 cycle,
// so it starts as a small, mostly-`other`-adjacent minor party.
// They don't have to sum to 100 since electoral calculations are normalized.

Q.urban_professional_yabloko = 22;
Q.urban_professional_kprf = 8;
Q.urban_professional_ldpr = 6;
Q.urban_professional_ndr = 14;
Q.urban_professional_rpr = 2;
Q.urban_professional_other = 48;

Q.intelligentsia_pensioners_yabloko = 14;
Q.intelligentsia_pensioners_kprf = 20;
Q.intelligentsia_pensioners_ldpr = 5;
Q.intelligentsia_pensioners_ndr = 10;
Q.intelligentsia_pensioners_rpr = 1;
Q.intelligentsia_pensioners_other = 50;

Q.working_class_yabloko = 3;
Q.working_class_kprf = 30;
Q.working_class_ldpr = 14;
Q.working_class_ndr = 8;
Q.working_class_rpr = 0;
Q.working_class_other = 45;

Q.rural_yabloko = 2;
Q.rural_kprf = 28;
Q.rural_ldpr = 10;
Q.rural_ndr = 7;
Q.rural_rpr = 0;
Q.rural_other = 53;

Q.business_entrepreneurial_yabloko = 15;
Q.business_entrepreneurial_kprf = 2;
Q.business_entrepreneurial_ldpr = 4;
Q.business_entrepreneurial_ndr = 18;
Q.business_entrepreneurial_rpr = 1;
Q.business_entrepreneurial_other = 60;

// youth_diaspora is a small, largely dormant class in 1998 - its real
// significance begins after the 2011-2012 "For Fair Elections" cycle and
// again post-2022. Kept nonzero here so the class exists cleanly for the
// election algorithm from turn one.
Q.youth_diaspora_yabloko = 10;
Q.youth_diaspora_kprf = 5;
Q.youth_diaspora_ldpr = 8;
Q.youth_diaspora_ndr = 6;
Q.youth_diaspora_rpr = 1;
Q.youth_diaspora_other = 70;

// ===== CURRENT DUMA COMPOSITION (1998, inherited from Dec 1995 election) =====
// PR and FPTP tracked separately per DESIGN_DOC §4's mixed-member model.
// Source: IPU Parline, 1995 Russian legislative election.
Q.yabloko_pr_seats = 31;
Q.yabloko_fptp_seats = 14;
Q.yabloko_total_seats = 45;

Q.kprf_pr_seats = 99;
Q.kprf_fptp_seats = 58;
Q.kprf_total_seats = 157;

Q.ldpr_pr_seats = 50;
Q.ldpr_fptp_seats = 1;
Q.ldpr_total_seats = 51;

Q.ndr_pr_seats = 45;
Q.ndr_fptp_seats = 10;
Q.ndr_total_seats = 55;

Q.rpr_pr_seats = 0;
Q.rpr_fptp_seats = 0;
Q.rpr_total_seats = 0;

Q.other_pr_seats = 0;
Q.other_fptp_seats = 142;
Q.other_total_seats = 142;

// ===== PRESIDENCY AND GOVERNMENT =====
// Leaders are tracked as strings, matching the base game's Q.president/Q.chancellor
// convention, not as boolean per-name flags - allows direct reference in event text
// (e.g. "{Q.leader} announced...") and clean handling of leadership succession.
Q.president = "Yeltsin";
Q.president_party = "I";
Q.president_ideology = "Yeltsin";
Q.prime_minister = "Chernomyrdin";
Q.prime_minister_party = "NDR";

Q.leader = "Yavlinsky";
Q.leader_party_role = "Chairman";

// leaders of other parties - real, named figures, matching the base game's
// convention of tracking rival-party leadership as strings (e.g. its own
// z_leader/dnvp_leader-style fields), not just Yabloko's own leadership.
Q.kprf_leader = "Zyuganov";
Q.ldpr_leader = "Zhirinovsky";
Q.ndr_leader = "Chernomyrdin";
Q.rpr_leader = "Vladimir Lysenko";

// is Yabloko participating in government?
Q.yabloko_in_government = 0;
Q.yabloko_in_government_time = 0;
Q.yabloko_in_government_total_time = 0;
Q.kprf_in_government = 0;
Q.ldpr_in_government = 0;
Q.ndr_in_government = 1;
Q.rpr_in_government = 0;

// coalition/toleration types, mirroring the base game's named-coalition
// taxonomy but remapped to Russia's presidential (not parliamentary-coalition)
// system: Yabloko's real relationship to government has mostly been
// toleration/technocratic-cooperation rather than formal coalition membership.
Q.in_technocrat_cooperation = 0;
Q.yabloko_toleration = 0;
Q.in_opposition = 1;
Q.minority_government = 0;

// ministries - which parties/individuals hold which portfolios.
// Zadornov became finance minister in November 1997 under Chernomyrdin.
// He was a Yabloko founding member and Duma deputy, but joined the cabinet
// without party authorization and was expelled/withdrew from Yabloko as a
// direct result - so as of Jan 1998 he sits in government as an Independent,
// not as a Yabloko minister, despite his origins in the party. He was later
// re-elected as a Yabloko party-list deputy from 2000-2005, so a recruit-him-
// back mechanic (an advisor action or party-affairs card, not yet written in
// this file) is historically accurate, not just a nice-to-have.
Q.finance_minister = "Zadornov";
Q.finance_minister_party = "I";
Q.zadornov_recruited_back = 0;
Q.foreign_minister = "Primakov";
Q.foreign_minister_party = "I";
Q.interior_minister = "Kulikov";
Q.interior_minister_party = "I";
Q.justice_minister = "Stepashin";
Q.justice_minister_party = "I";
Q.defense_minister = "Sergeyev";
Q.defense_minister_party = "I";
Q.economy_minister = "Kirienko";
Q.economy_minister_party = "I";
Q.agriculture_minister = "Khlystun";
Q.agriculture_minister_party = "I";
Q.communications_minister = "Bulgak";
Q.communications_minister_party = "NDR";
Q.culture_minister = "Dementyeva";
Q.culture_minister_party = "I";
Q.health_minister = "Dmitrieva";
Q.health_minister_party = "NDR";
Q.labor_minister = "Sysuyev";
Q.labor_minister_party = "NDR";
Q.transport_minister = "Tsakh";
Q.transport_minister_party = "I";

Q.coalition_dissent = 0;
Q.zadornov_resigned = 0;

// ===== INTER-PARTY RELATIONS =====
Q.kprf_relation = 20;
Q.ldpr_relation = 10;
Q.ndr_relation = 45;
Q.rpr_relation = 55;
// SPS, SR relations initialize on formation, not here.

// executive relation - the Yeltsin-era equivalent of the base game's
// hindenburg_relation track. Represents the party's working relationship
// with the presidential administration, not personal favor.
Q.executive_relation = 35;
Q.executive_pressure = 0;

// ===== SECURITY FORCES, EXTREMIST GROUPS, AND ORGANIZED CRIME =====
// mirrors the base game's paramilitary-strength tracks (sa_strength, rfb_strength,
// stahlhelm_strength etc.) but remapped: Russia in this period doesn't have Weimar-style
// party paramilitaries, so these represent the actual state security apparatus plus a
// genuinely marginal extremist fringe, not competing party militias.
// Strength values are in THOUSANDS of personnel/members throughout this block.
// Loyalty means loyalty/sympathy toward Yabloko specifically, not the state.
// Militancy means how well-equipped/armed a force is (0-100 scale), independent
// of headcount - a large but poorly-equipped force and a small but heavily-armed
// one can occupy very different points on this axis.

// the military (armed forces) - relevant to Chechnya-era events, coup risk in
// the loosest sense, and later Act IV mobilization-adjacent content.
// sourced: ~1,702,000 personnel in 1998 (Statista/World Bank armed forces series).
// Yabloko is an opposition party with no command relationship to the armed forces,
// so loyalty starts very low. Militancy starts high - full conventional armament,
// armor, aircraft, and (relevant to later events) nuclear forces - notwithstanding
// the real, well-documented readiness and funding crisis of the late-1990s military.
Q.military_strength = 1702;
Q.military_loyalty = 5;
Q.military_militancy = 75;

// police (MVD regular militia) and internal troops (VV), tracked separately -
// relevant to protest policing, later state_pressure enforcement, and the
// OMON-adjacent events of Act III/IV.
// sourced: ~500,000 regular police + ~257,000 internal troops in 1998
// (factsanddetails.com, MVD/police in Russia, and Internal Troops sourcing).
// loyalty starts very low for the same reason as military_loyalty above.
// Militancy: regular police are lightly equipped for ordinary policing; internal
// troops (VV) are the better-armed, riot-control/paramilitary-adjacent tier of
// the MVD, so they sit meaningfully higher on the militancy axis than regular police.
Q.police_strength = 500;
Q.police_loyalty = 3;
Q.police_militancy = 30;
Q.internal_troops_strength = 257;
Q.internal_troops_loyalty = 3;
Q.internal_troops_militancy = 55;

// EMERCOM / MChS - Russia's Emergency Situations Ministry, formed 1994 under
// Sergei Shoigu. Distinct from police/military - handles disaster response, but
// historically also a politically useful, personality-driven ministry (Shoigu's
// own long tenure and eventual political career began here). Tracked separately
// since it is neither a party nor a purely coercive force.
// sourced: ~23,000 civil protection troops as of 1999 (GlobalSecurity/EMERCOM);
// used as the closest available proxy for the Jan 1998 starting figure.
// Militancy is low-moderate - equipped for rescue/disaster response (engineering,
// medical, radiation/chemical protection gear) rather than for coercive force.
Q.mchs_strength = 23;
Q.mchs_head = "Shoigu";
Q.mchs_militancy = 15;

// extremist fringe groups - very low strength/militancy in 1998, present but
// marginal. The National Bolshevik Party (Nazbols, founded 1993 under Limonov
// and Dugin) is the clearest real anchor: unregistered, genuinely small, prone
// to stunts rather than organized violence at this point in its history (it
// would not be formally "legalized" until 2005, then banned in 2007). No
// precise sourced 1998 NBP membership figure exists; kept as a rough, clearly
// approximate low estimate rather than a sourced figure like the forces above.
// Kept distinct from Q.other's electoral vote share, since NBP-style groups
// were not meaningfully contesting elections in this period - this is closer
// to a public-order/radicalization risk track than a vote-share competitor.
// Militancy is very low for both groups at this point - street-level scuffles,
// occasional illegal weapons possession (as with the NBP's real 1992 grenade
// arrests), not organized paramilitary capability.
Q.nazbol_strength = 3;
Q.nazbol_militancy = 5;
Q.far_right_extremist_strength = 4;
Q.far_right_extremist_militancy = 8;

// organized crime - a genuinely major feature of 1990s Russia, distinct from the
// small ideological fringe groups above: this is much larger, apolitical, and
// operates through corruption/extortion/business infiltration rather than street
// violence or political messaging. sourced: MVD's own late-1990s estimate of
// ~5,700-8,000 criminal groups with a combined membership around 100,000
// (country-data.com/MVD 1994 estimate; Bagley, "Rise of Russian Organized Crime").
// Loyalty is not meaningful in the same sense as for state forces or Yabloko-
// adjacent groups - organized crime in this period related to politicians mostly
// through corruption/patronage rather than ideological sympathy, so this is left
// unset here and any relevant relationship should be modeled through bribery/
// corruption-specific events rather than a loyalty stat.
// Militancy is real but generally sub-military - firearms, some ex-military/
// ex-security personnel among "enforcers," but not comparable to state forces'
// heavy weapons and armor.
Q.organized_crime_strength = 100;
Q.organized_crime_militancy = 35;

// ===== FOREIGN AGENT / STATE PRESSURE SYSTEM =====
// see DESIGN_DOC §7. Dormant until Act IV; declared here so any Act I figure
// referenced later in the timeline has a consistent flag to check even if it's
// never set during Act I itself.
Q.foreign_agent_designations = 0;

// ===== RECORDS =====
Q.election_records = [];
Q.party_support_records = [];
Q.economic_records = [];

!}
go-to: main
