title: Status
new-page: true
is-special: true
# NOTE: the @polls tab below references _votes and _display variables
# (e.g. yabloko_votes, urban_professional_yabloko_display) that are meant to
# be computed by election_algorithm.scene.dry, per DESIGN_DOC §4. That file
# has not been written yet - this tab is structurally complete and will work
# once the algorithm exists, but will show blank/undefined values until then.
on-arrival: {!
if (Q.inflation) {
    Q.inflation_2 = Q.inflation.toFixed(1);
}
if (Q.unemployment) {
    Q.unemployment_2 = Q.unemployment.toFixed(1);
}
Q.economic_growth_2 = '0';
if (Q.economic_growth) {
    Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}
!}

= Status

